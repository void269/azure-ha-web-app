#!/usr/bin/env bash

#######################################
# General
#######################################

AZURE_SUBSCRIPTION_NAME="Azure subscription 1" # Replace with your Azure subscription name
RESOURCE_GROUP="rand-lb-project-rg"
LOCATION="eastus"

#######################################
# SSH
#######################################

SSH_KEY_NAME="rand-vm-ssh-key"
SSH_NAT_PORT_BASE=50000
SSH_SOURCE_ADDRESS_PREFIX="Internet" # Internet allows SSH from anywhere. For better security, replace with your public IP.

#######################################
# Networking
#######################################

VNET_NAME="rand-vnet"
VNET_ADDRESS_PREFIX="10.0.0.0/16"
SUBNET_NAME="app-subnet"
SUBNET_PREFIX="10.0.1.0/24"
NSG_NAME="app-nsg"

#######################################
# Load Balancer
#######################################

PUBLIC_IP_NAME="rand-lb-public-ip"
LB_NAME="rand-public-lb"
FRONTEND_NAME="lb-frontend"
BACKEND_POOL_NAME="web-backend-pool"
PROBE_NAME="http-health-probe"
LB_RULE_NAME="http-rule"

#######################################
# Virtual Machines
#######################################

VM_COUNT=2
VM_PREFIX="web-vm"
VM_SIZE="Standard_D2als_v7"
ADMIN_USERNAME="azureuser"