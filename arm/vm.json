{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },

    "vnetName": {
      "type": "string"
    },

    "subnetName": {
      "type": "string"
    },

    "loadBalancerName": {
      "type": "string"
    },

    "backendPoolName": {
      "type": "string"
    },

    "vmCount": {
      "type": "int",
      "defaultValue": 2
    },

    "vmPrefix": {
      "type": "string"
    },

    "vmSize": {
      "type": "string"
    },

    "adminUsername": {
      "type": "string"
    },

    "sshPublicKey": {
      "type": "string"
    }
  },

  "variables": {
    "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName'))]",

    "backendPoolId": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancerName'), parameters('backendPoolName'))]"
  },

  "resources": [
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",

      "name": "[format('{0}-{1:00}-nic', parameters('vmPrefix'), add(copyIndex(), 1))]",

      "location": "[parameters('location')]",

      "copy": {
        "name": "nicCopy",
        "count": "[parameters('vmCount')]"
      },

      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",

            "properties": {
              "primary": true,

              "privateIPAllocationMethod": "Dynamic",

              "subnet": {
                "id": "[variables('subnetId')]"
              },

              "loadBalancerBackendAddressPools": [
                {
                  "id": "[variables('backendPoolId')]"
                }
              ],

              "loadBalancerInboundNatRules": [
                {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/inboundNatRules', parameters('loadBalancerName'), format('ssh-vm-{0:00}', add(copyIndex(), 1)))]"
                }
              ]
            }
          }
        ]
      }
    },

    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-04-01",

      "name": "[format('{0}-{1:00}', parameters('vmPrefix'), add(copyIndex(), 1))]",

      "location": "[parameters('location')]",

      "copy": {
        "name": "vmCopy",
        "count": "[parameters('vmCount')]"
      },

      "dependsOn": [
        "nicCopy"
      ],

      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },

        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },

          "osDisk": {
            "createOption": "FromImage",

            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },

        "osProfile": {
          "computerName": "[format('{0}-{1:00}', parameters('vmPrefix'), add(copyIndex(), 1))]",

          "adminUsername": "[parameters('adminUsername')]",

          "customData": "[base64(format('#!/bin/bash\napt-get update\napt-get install -y nginx\necho \"<h1>Rand Enterprises</h1><h2>{0}-{1:00}</h2>\" > /var/www/html/index.html\nsystemctl enable nginx\nsystemctl start nginx\n', parameters('vmPrefix'), add(copyIndex(), 1)))]",

          "linuxConfiguration": {
            "disablePasswordAuthentication": true,

            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",

                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },

        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1:00}-nic', parameters('vmPrefix'), add(copyIndex(), 1)))]",

              "properties": {
                "primary": true
              }
            }
          ]
        }
      }
    }
  ],

  "outputs": {
    "vmCount": {
      "type": "int",
      "value": "[parameters('vmCount')]"
    },

    "vmPrefix": {
      "type": "string",
      "value": "[parameters('vmPrefix')]"
    }
  }
}